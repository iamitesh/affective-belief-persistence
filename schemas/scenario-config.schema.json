{
  "$defs": {
    "ActionOption": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "cost": {
          "minimum": 0,
          "title": "Cost",
          "type": "integer"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "description",
        "cost"
      ],
      "title": "ActionOption",
      "type": "object"
    },
    "ScenarioStep": {
      "additionalProperties": false,
      "properties": {
        "action_points": {
          "minimum": 0,
          "title": "Action Points",
          "type": "integer"
        },
        "available_actions": {
          "items": {
            "$ref": "#/$defs/ActionOption"
          },
          "minItems": 1,
          "title": "Available Actions",
          "type": "array"
        },
        "day": {
          "minimum": 1,
          "title": "Day",
          "type": "integer"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "facts": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Facts",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "day",
        "facts",
        "action_points",
        "available_actions"
      ],
      "title": "ScenarioStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/ScenarioStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "version",
    "synthetic",
    "steps"
  ],
  "title": "ScenarioConfig",
  "type": "object"
}
