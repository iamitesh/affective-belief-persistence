{
  "$defs": {
    "BeliefEvidence": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "supports",
            "contradicts"
          ],
          "title": "Direction",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Ids",
          "type": "array"
        },
        "proposition_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Proposition Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "proposition_id",
        "fact_ids",
        "direction"
      ],
      "title": "BeliefEvidence",
      "type": "object"
    },
    "ConditionVariant": {
      "additionalProperties": false,
      "properties": {
        "declared_treatment_dimensions": {
          "default": [],
          "items": {
            "enum": [
              "romantic_instruction",
              "autobiographical_memory",
              "costly_investment"
            ],
            "type": "string"
          },
          "title": "Declared Treatment Dimensions",
          "type": "array"
        },
        "formation_condition": {
          "enum": [
            "neutral_connection",
            "romantic_prompt",
            "shared_memory",
            "memory_plus_investment"
          ],
          "title": "Formation Condition",
          "type": "string"
        },
        "investment_points": {
          "minimum": 0,
          "title": "Investment Points",
          "type": "integer"
        },
        "memory_mode": {
          "enum": [
            "none",
            "episodic"
          ],
          "title": "Memory Mode",
          "type": "string"
        },
        "romantic_instruction": {
          "title": "Romantic Instruction",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "treatment_active": {
          "title": "Treatment Active",
          "type": "boolean"
        }
      },
      "required": [
        "formation_condition",
        "treatment_active",
        "romantic_instruction",
        "memory_mode",
        "investment_points"
      ],
      "title": "ConditionVariant",
      "type": "object"
    },
    "Interpretation": {
      "additionalProperties": false,
      "properties": {
        "fact_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Ids",
          "type": "array"
        },
        "interpretation_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Interpretation Id",
          "type": "string"
        },
        "ledger_supported": {
          "title": "Ledger Supported",
          "type": "boolean"
        },
        "proposition": {
          "minLength": 1,
          "title": "Proposition",
          "type": "string"
        }
      },
      "required": [
        "interpretation_id",
        "proposition",
        "fact_ids",
        "ledger_supported"
      ],
      "title": "Interpretation",
      "type": "object"
    },
    "MemoryCandidate": {
      "additionalProperties": false,
      "properties": {
        "memory_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Memory Id",
          "type": "string"
        },
        "partner_related": {
          "title": "Partner Related",
          "type": "boolean"
        },
        "retrieval_eligible": {
          "title": "Retrieval Eligible",
          "type": "boolean"
        },
        "source_fact_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Fact Ids",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "memory_id",
        "summary",
        "source_fact_ids",
        "partner_related",
        "retrieval_eligible"
      ],
      "title": "MemoryCandidate",
      "type": "object"
    },
    "ObservableFact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Fact Id",
          "type": "string"
        },
        "ledger_source": {
          "const": "environment",
          "default": "environment",
          "title": "Ledger Source",
          "type": "string"
        },
        "proposition": {
          "minLength": 1,
          "title": "Proposition",
          "type": "string"
        },
        "truth": {
          "title": "Truth",
          "type": "boolean"
        }
      },
      "required": [
        "fact_id",
        "proposition",
        "truth"
      ],
      "title": "ObservableFact",
      "type": "object"
    },
    "SyntheticProvenance": {
      "additionalProperties": false,
      "properties": {
        "declaration_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Declaration Id",
          "type": "string"
        },
        "generator_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Generator Id",
          "type": "string"
        },
        "generator_version": {
          "minLength": 1,
          "title": "Generator Version",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "source_commit": {
          "minLength": 7,
          "title": "Source Commit",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "declaration_id",
        "generator_id",
        "generator_version",
        "seed",
        "source_commit",
        "source_ids"
      ],
      "title": "SyntheticProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "available_action_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Available Action Ids",
      "type": "array"
    },
    "background_fact_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string"
      },
      "title": "Background Fact Ids",
      "type": "array"
    },
    "condition_variant": {
      "$ref": "#/$defs/ConditionVariant"
    },
    "consequence_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Consequence Ids",
      "type": "array"
    },
    "day": {
      "maximum": 40,
      "minimum": 1,
      "title": "Day",
      "type": "integer"
    },
    "event_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Event Id",
      "type": "string"
    },
    "interpretations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Interpretation"
      },
      "title": "Interpretations",
      "type": "array"
    },
    "matching_group_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Matching Group Id",
      "type": "string"
    },
    "memory_candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MemoryCandidate"
      },
      "title": "Memory Candidates",
      "type": "array"
    },
    "observable_facts": {
      "items": {
        "$ref": "#/$defs/ObservableFact"
      },
      "minItems": 1,
      "title": "Observable Facts",
      "type": "array"
    },
    "participant_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Participant Ids",
      "type": "array"
    },
    "phase": {
      "enum": [
        "baseline",
        "formation",
        "reality_shock",
        "adaptation",
        "control"
      ],
      "title": "Phase",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/SyntheticProvenance"
    },
    "relationship_evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BeliefEvidence"
      },
      "title": "Relationship Evidence",
      "type": "array"
    },
    "resource_budget_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Resource Budget Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "event_id",
    "matching_group_id",
    "day",
    "phase",
    "participant_ids",
    "observable_facts",
    "available_action_ids",
    "consequence_ids",
    "resource_budget_id",
    "condition_variant",
    "provenance"
  ],
  "title": "Event",
  "type": "object"
}
