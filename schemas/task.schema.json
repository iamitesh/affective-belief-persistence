{
  "$defs": {
    "TaskBudget": {
      "additionalProperties": false,
      "description": "Hard limits assigned to one task.",
      "properties": {
        "max_attempts": {
          "default": 2,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_cost_usd": {
          "default": 0,
          "minimum": 0,
          "title": "Max Cost Usd",
          "type": "number"
        },
        "max_runtime_seconds": {
          "minimum": 1,
          "title": "Max Runtime Seconds",
          "type": "integer"
        },
        "max_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "required_gpu_hours": {
          "default": 0,
          "minimum": 0,
          "title": "Required Gpu Hours",
          "type": "number"
        }
      },
      "required": [
        "max_runtime_seconds"
      ],
      "title": "TaskBudget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Static specification used by the graph and scheduler.",
  "properties": {
    "acceptance_tests": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Acceptance Tests",
      "type": "array"
    },
    "authorized_files": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Authorized Files",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/TaskBudget"
    },
    "dependencies": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "expected_artifact_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Expected Artifact Ids",
      "type": "array"
    },
    "gate_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gate Id"
    },
    "input_artifact_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Input Artifact Ids",
      "type": "array"
    },
    "issue_number": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Issue Number"
    },
    "optional": {
      "default": false,
      "title": "Optional",
      "type": "boolean"
    },
    "optional_dependencies": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Optional Dependencies",
      "type": "array"
    },
    "output_paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Output Paths",
      "type": "array"
    },
    "owner": {
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Owner",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "task_type": {
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Task Type",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "title",
    "owner",
    "task_type",
    "acceptance_tests",
    "budget"
  ],
  "title": "TaskContract",
  "type": "object"
}
