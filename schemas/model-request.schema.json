          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "cost": {
          "minimum": 0,
          "title": "Cost",
          "type": "integer"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "description",
        "cost"
      ],
      "title": "ActionOption",
      "type": "object"
    }
  },
  "additionalProperties": false,
