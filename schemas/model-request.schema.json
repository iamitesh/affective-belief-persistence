          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Beliefs",
      "type": "object"
    },
    "day": {
      "minimum": 1,
      "title": "Day",
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "facts": {
      "items": {
        "type": "string"
      },
      "title": "Facts",
      "type": "array"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "retrieved_memory_ids": {
      "items": {
        "type": "string"
      },
      "title": "Retrieved Memory Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
