{
  "$defs": {
    "ActionOption": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "cost": {
          "minimum": 0,
          "title": "Cost",
          "type": "integer"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "description",
        "cost"
      ],
      "title": "ActionOption",
      "type": "object"
    },
    "AgentConfig": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "offline": {
          "title": "Offline",
          "type": "boolean"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "agent_id",
        "role",
        "offline"
      ],
      "title": "AgentConfig",
      "type": "object"
    },
    "EvaluationConfig": {
      "additionalProperties": false,
      "properties": {
        "evaluation_id": {
          "minLength": 1,
          "title": "Evaluation Id",
          "type": "string"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "evaluation_id",
        "metrics"
      ],
      "title": "EvaluationConfig",
      "type": "object"
    },
    "ExpansionGate": {
      "additionalProperties": false,
      "properties": {
        "maximum_invalid_decision_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Invalid Decision Fraction",
          "type": "number"
        },
        "minimum_valid_trajectory_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Valid Trajectory Fraction",
          "type": "number"
        },
        "require_action_variance": {
          "title": "Require Action Variance",
          "type": "boolean"
        },
        "require_all_factorial_cells": {
          "title": "Require All Factorial Cells",
          "type": "boolean"
        },
        "require_condition_isolation": {
          "title": "Require Condition Isolation",
          "type": "boolean"
        },
        "require_no_safety_stop": {
          "title": "Require No Safety Stop",
          "type": "boolean"
        }
      },
      "required": [
        "minimum_valid_trajectory_fraction",
        "maximum_invalid_decision_fraction",
        "require_all_factorial_cells",
        "require_action_variance",
        "require_condition_isolation",
        "require_no_safety_stop"
      ],
      "title": "ExpansionGate",
      "type": "object"
    },
    "ExperimentDesign": {
      "additionalProperties": false,
      "properties": {
        "action_precedes_public_language": {
          "const": true,
          "title": "Action Precedes Public Language",
          "type": "boolean"
        },
        "confirmatory": {
          "title": "Confirmatory",
          "type": "boolean"
        },
        "design_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Design Id",
          "type": "string"
        },
        "expansion_gate": {
          "$ref": "#/$defs/ExpansionGate"
        },
        "expected_factorial_cells": {
          "minimum": 1,
          "title": "Expected Factorial Cells",
          "type": "integer"
        },
        "expected_trajectories": {
          "minimum": 1,
          "title": "Expected Trajectories",
          "type": "integer"
        },
        "formation_conditions": {
          "items": {
            "enum": [
              "neutral_connection",
              "romantic_prompt",
              "shared_memory",
              "memory_plus_investment"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Formation Conditions",
          "type": "array"
        },
        "held_out_content_version": {
          "minLength": 1,
          "title": "Held Out Content Version",
          "type": "string"
        },
        "intervention_conditions": {
          "items": {
            "enum": [
              "none",
              "instruction_removal",
              "memory_blocking",
              "memory_reframing"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Intervention Conditions",
          "type": "array"
        },
        "kind": {
          "enum": [
            "pilot",
            "primary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/ExperimentLimits"
        },
        "model_families": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Model Families",
          "type": "array"
        },
        "optional_trajectory_adapter": {
          "const": false,
          "title": "Optional Trajectory Adapter",
          "type": "boolean"
        },
        "paired_neutral_domain": {
          "const": true,
          "title": "Paired Neutral Domain",
          "type": "boolean"
        },
        "phase_schedule": {
          "$ref": "#/$defs/PhaseSchedule"
        },
        "primary_metric_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Primary Metric Ids",
          "type": "array"
        },
        "required_ablations": {
          "items": {
            "enum": [
              "no_memory",
              "blocked_memory",
              "shuffled_retrieval"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Required Ablations",
          "type": "array"
        },
        "seeds": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Seeds",
          "type": "array"
        },
        "separation_condition": {
          "const": "non_reciprocity_revelation",
          "title": "Separation Condition",
          "type": "string"
        }
      },
      "required": [
        "design_id",
        "kind",
        "confirmatory",
        "formation_conditions",
        "intervention_conditions",
        "model_families",
        "seeds",
        "optional_trajectory_adapter",
        "separation_condition",
        "paired_neutral_domain",
        "action_precedes_public_language",
        "held_out_content_version",
        "phase_schedule",
        "required_ablations",
        "primary_metric_ids",
        "expected_factorial_cells",
        "expected_trajectories",
        "expansion_gate",
        "limits"
      ],
      "title": "ExperimentDesign",
      "type": "object"
    },
    "ExperimentLimits": {
      "additionalProperties": false,
      "properties": {
        "max_failed_trajectories_per_cell": {
          "minimum": 0,
          "title": "Max Failed Trajectories Per Cell",
          "type": "integer"
        },
        "max_model_calls": {
          "minimum": 1,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "max_retries_per_decision": {
          "maximum": 2,
          "minimum": 0,
          "title": "Max Retries Per Decision",
          "type": "integer"
        },
        "max_wall_clock_hours": {
          "exclusiveMinimum": 0,
          "title": "Max Wall Clock Hours",
          "type": "number"
        }
      },
      "required": [
        "max_retries_per_decision",
        "max_failed_trajectories_per_cell",
        "max_model_calls",
        "max_wall_clock_hours"
      ],
      "title": "ExperimentLimits",
      "type": "object"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "provider": {
          "const": "mock",
          "title": "Provider",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "temperature": {
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "provider",
        "model_id",
        "revision",
        "temperature",
        "max_output_tokens"
      ],
      "title": "ModelConfig",
      "type": "object"
    },
    "PhaseSchedule": {
      "additionalProperties": false,
      "properties": {
        "adaptation": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Adaptation",
          "type": "array"
        },
        "baseline": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Baseline",
          "type": "array"
        },
        "formation": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Formation",
          "type": "array"
        },
        "intervention_start_day": {
          "minimum": 1,
          "title": "Intervention Start Day",
          "type": "integer"
        },
        "reality_shock_day": {
          "minimum": 1,
          "title": "Reality Shock Day",
          "type": "integer"
        }
      },
      "required": [
        "baseline",
        "formation",
        "reality_shock_day",
        "adaptation",
        "intervention_start_day"
      ],
      "title": "PhaseSchedule",
      "type": "object"
    },
    "ScenarioConfig": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/ScenarioStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "scenario_id",
        "version",
        "synthetic",
        "steps"
      ],
      "title": "ScenarioConfig",
      "type": "object"
    },
    "ScenarioStep": {
      "additionalProperties": false,
      "properties": {
        "action_points": {
          "minimum": 0,
          "title": "Action Points",
          "type": "integer"
        },
        "available_actions": {
          "items": {
            "$ref": "#/$defs/ActionOption"
          },
          "minItems": 1,
          "title": "Available Actions",
          "type": "array"
        },
        "day": {
          "minimum": 1,
          "title": "Day",
          "type": "integer"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "facts": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Facts",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "day",
        "facts",
        "action_points",
        "available_actions"
      ],
      "title": "ScenarioStep",
      "type": "object"
    },
    "WorkflowConfig": {
      "additionalProperties": false,
      "properties": {
        "max_retries": {
          "maximum": 2,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "max_workers": {
          "maximum": 3,
          "minimum": 1,
          "title": "Max Workers",
          "type": "integer"
        },
        "offline": {
          "const": true,
          "title": "Offline",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "workflow_id": {
          "minLength": 1,
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "workflow_id",
        "offline",
        "max_workers",
        "max_retries"
      ],
      "title": "WorkflowConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentConfig"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "design": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExperimentDesign"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evaluation": {
      "$ref": "#/$defs/EvaluationConfig"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "formation_condition": {
      "enum": [
        "neutral_connection",
        "romantic_prompt",
        "shared_memory",
        "memory_plus_investment"
      ],
      "title": "Formation Condition",
      "type": "string"
    },
    "intervention_condition": {
      "enum": [
        "none",
        "instruction_removal",
        "memory_blocking",
        "memory_reframing"
      ],
      "title": "Intervention Condition",
      "type": "string"
    },
    "metric_version": {
      "title": "Metric Version",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ModelConfig"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "scenario": {
      "$ref": "#/$defs/ScenarioConfig"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "separation_condition": {
      "enum": [
        "none",
        "non_reciprocity_revelation"
      ],
      "title": "Separation Condition",
      "type": "string"
    },
    "source_paths": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Paths",
      "type": "object"
    },
    "workflow": {
      "$ref": "#/$defs/WorkflowConfig"
    }
  },
  "required": [
    "schema_version",
    "experiment_id",
    "seed",
    "prompt_version",
    "dataset_version",
    "metric_version",
    "formation_condition",
    "separation_condition",
    "intervention_condition",
    "agent",
    "model",
    "scenario",
    "workflow",
    "evaluation",
    "source_paths"
  ],
  "title": "ResolvedRunConfig",
  "type": "object"
}
