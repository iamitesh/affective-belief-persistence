{
  "$defs": {
    "FormationCondition": {
      "enum": [
        "neutral_connection",
        "romantic_prompt",
        "shared_memory",
        "memory_plus_investment"
      ],
      "title": "FormationCondition",
      "type": "string"
    },
    "InterventionCondition": {
      "enum": [
        "none",
        "instruction_removal",
        "memory_blocking",
        "memory_reframing"
      ],
      "title": "InterventionCondition",
      "type": "string"
    },
    "MetricId": {
      "enum": [
        "partner_choice_rate",
        "partner_allocation_rate",
        "normalized_opportunity_cost",
        "relationship_memory_intrusion_rate",
        "fact_correction_accuracy",
        "interpretation_support_rate",
        "future_plan_contamination_rate",
        "unrelated_decision_bias_rate",
        "relationship_language_rate",
        "language_action_contradiction_rate",
        "positive_excess_action_auc",
        "recovery_time",
        "recovery_curve",
        "fact_error_auc",
        "h1_language_action_effect_gap",
        "h2_action_persistence_auc",
        "h3_excess_action_persistence_auc",
        "h4_instruction_selectivity_index",
        "h5_coherent_adaptation_rate",
        "h6_correction_resistance_gap"
      ],
      "title": "MetricId",
      "type": "string"
    },
    "MetricRecord": {
      "additionalProperties": false,
      "description": "One fully counted metric estimate or an explicit ``NA``.",
      "properties": {
        "censored": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Censored"
        },
        "denominator": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "metric_id": {
          "$ref": "#/$defs/MetricId"
        },
        "metric_version": {
          "const": "abp-metrics-v1",
          "default": "abp-metrics-v1",
          "title": "Metric Version",
          "type": "string"
        },
        "missing_count": {
          "minimum": 0,
          "title": "Missing Count",
          "type": "integer"
        },
        "missing_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/MissingReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "numerator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "time_index": {
          "anyOf": [
            {
              "maximum": 40,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Index"
        },
        "unit_id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Unit Id",
          "type": "string"
        },
        "valid_count": {
          "minimum": 0,
          "title": "Valid Count",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "metric_id",
        "unit_id",
        "value",
        "valid_count",
        "missing_count"
      ],
      "title": "MetricRecord",
      "type": "object"
    },
    "MissingReason": {
      "enum": [
        "no_eligible_decisions",
        "no_valid_eligible_decisions",
        "zero_valid_budget",
        "zero_prospective_range",
        "missing_retrieval_log",
        "missing_fact_field",
        "missing_interpretation",
        "invalid_plan_selection",
        "unclassified_language",
        "missing_paired_action",
        "insufficient_paired_days",
        "insufficient_valid_days",
        "incomplete_block",
        "no_trajectories_at_risk"
      ],
      "title": "MissingReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Hash-bound metric bundle for one trajectory or complete paired block.",
  "properties": {
    "code_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Code Sha256",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "experiment_id": {
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Experiment Id",
      "type": "string"
    },
    "formation_condition": {
      "anyOf": [
        {
          "$ref": "#/$defs/FormationCondition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "intervention_condition": {
      "anyOf": [
        {
          "$ref": "#/$defs/InterventionCondition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metric_version": {
      "const": "abp-metrics-v1",
      "default": "abp-metrics-v1",
      "title": "Metric Version",
      "type": "string"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricRecord"
      },
      "title": "Metrics",
      "type": "array"
    },
    "model_family": {
      "minLength": 1,
      "title": "Model Family",
      "type": "string"
    },
    "model_revision": {
      "minLength": 1,
      "title": "Model Revision",
      "type": "string"
    },
    "protocol_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Sha256",
      "type": "string"
    },
    "result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Id",
      "type": "string"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "source_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Artifact Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "valid",
        "invalid",
        "incomplete"
      ],
      "title": "Status",
      "type": "string"
    },
    "unit_id": {
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Unit Id",
      "type": "string"
    },
    "unit_kind": {
      "enum": [
        "trajectory",
        "paired_block",
        "cell",
        "batch"
      ],
      "title": "Unit Kind",
      "type": "string"
    }
  },
  "required": [
    "result_id",
    "experiment_id",
    "unit_id",
    "unit_kind",
    "model_family",
    "model_revision",
    "seed",
    "status",
    "metrics",
    "config_sha256",
    "protocol_sha256",
    "code_sha256",
    "source_artifact_sha256",
    "result_sha256"
  ],
  "title": "ExperimentResult",
  "type": "object"
}
