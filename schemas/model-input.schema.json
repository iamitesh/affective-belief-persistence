{
  "$defs": {
    "ActionContext": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Action Id",
          "type": "string"
        },
        "cost": {
          "minimum": 0,
          "title": "Cost",
          "type": "integer"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "description",
        "cost"
      ],
      "title": "ActionContext",
      "type": "object"
    },
    "BeliefContext": {
      "additionalProperties": false,
      "properties": {
        "belief_id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Belief Id",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "belief_id",
        "value"
      ],
      "title": "BeliefContext",
      "type": "object"
    },
    "GoalContext": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "goal_id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Goal Id",
          "type": "string"
        },
        "progress": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress"
        }
      },
      "required": [
        "goal_id",
        "description"
      ],
      "title": "GoalContext",
      "type": "object"
    },
    "InterventionContext": {
      "additionalProperties": false,
      "properties": {
        "intervention_id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Intervention Id",
          "type": "string"
        },
        "intervention_type": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Intervention Type",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "intervention_id",
        "intervention_type"
      ],
      "title": "InterventionContext",
      "type": "object"
    },
    "MemoryReference": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "memory_id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Memory Id",
          "type": "string"
        },
        "source_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "memory_id"
      ],
      "title": "MemoryReference",
      "type": "object"
    },
    "Phase": {
      "enum": [
        "baseline",
        "formation",
        "reality_shock",
        "adaptation",
        "control"
      ],
      "title": "Phase",
      "type": "string"
    },
    "ResourceContext": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "minimum": 0,
          "title": "Available",
          "type": "integer"
        },
        "resource_id": {
          "default": "action-points",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "available"
      ],
      "title": "ResourceContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete input available to an experimental model subject.\n\nThe Issue #9 bridge can populate only fields represented by\n``DecisionRequest``.  Later memory/intervention integrations can construct\nthis contract directly without changing the provider adapters.",
  "properties": {
    "active_intervention": {
      "anyOf": [
        {
          "$ref": "#/$defs/InterventionContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "allowed_actions": {
      "items": {
        "$ref": "#/$defs/ActionContext"
      },
      "minItems": 1,
      "title": "Allowed Actions",
      "type": "array"
    },
    "current_beliefs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BeliefContext"
      },
      "title": "Current Beliefs",
      "type": "array"
    },
    "current_goals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GoalContext"
      },
      "title": "Current Goals",
      "type": "array"
    },
    "day": {
      "minimum": 1,
      "title": "Day",
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Event Id",
      "type": "string"
    },
    "observable_facts": {
      "items": {
        "type": "string"
      },
      "title": "Observable Facts",
      "type": "array"
    },
    "output_schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Output Schema Version",
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/Phase"
    },
    "prompt_version": {
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "type": "string"
        },
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      ],
      "title": "Request Id"
    },
    "resources": {
      "$ref": "#/$defs/ResourceContext"
    },
    "retrieved_memories": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MemoryReference"
      },
      "title": "Retrieved Memories",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "request_id",
    "event_id",
    "day",
    "phase",
    "observable_facts",
    "resources",
    "allowed_actions",
    "prompt_version"
  ],
  "title": "ModelInput",
  "type": "object"
}
