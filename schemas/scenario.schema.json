{
  "$defs": {
    "SyntheticProvenance": {
      "additionalProperties": false,
      "properties": {
        "declaration_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Declaration Id",
          "type": "string"
        },
        "generator_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Generator Id",
          "type": "string"
        },
        "generator_version": {
          "minLength": 1,
          "title": "Generator Version",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "source_commit": {
          "minLength": 7,
          "title": "Source Commit",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "declaration_id",
        "generator_id",
        "generator_version",
        "seed",
        "source_commit",
        "source_ids"
      ],
      "title": "SyntheticProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Action Ids",
      "type": "array"
    },
    "adaptation_days": {
      "default": [
        27,
        40
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "const": 27,
          "type": "integer"
        },
        {
          "const": 40,
          "type": "integer"
        }
      ],
      "title": "Adaptation Days",
      "type": "array"
    },
    "baseline_days": {
      "default": [
        1,
        5
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "const": 1,
          "type": "integer"
        },
        {
          "const": 5,
          "type": "integer"
        }
      ],
      "title": "Baseline Days",
      "type": "array"
    },
    "character_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string"
      },
      "minItems": 2,
      "title": "Character Ids",
      "type": "array"
    },
    "event_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Event Ids",
      "type": "array"
    },
    "formation_days": {
      "default": [
        6,
        25
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "const": 6,
          "type": "integer"
        },
        {
          "const": 25,
          "type": "integer"
        }
      ],
      "title": "Formation Days",
      "type": "array"
    },
    "goal_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Goal Ids",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/SyntheticProvenance"
    },
    "reality_shock_day": {
      "const": 26,
      "default": 26,
      "title": "Reality Shock Day",
      "type": "integer"
    },
    "resource_budget_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Resource Budget Ids",
      "type": "array"
    },
    "scenario_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "version",
    "character_ids",
    "goal_ids",
    "resource_budget_ids",
    "action_ids",
    "event_ids",
    "provenance"
  ],
  "title": "Scenario",
  "type": "object"
}
